{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w3os.org/schemas/tool.json",
  "title": "W3OS Tool",
  "description": "An open-source opsec/web3-security tool listed on W3OS",
  "type": "object",
  "required": ["slug", "name", "description", "repo_url", "maintainer_slug", "tags"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "repo_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "maintainer_slug": {
      "type": "string",
      "description": "slug of the company in data/companies/ that maintains this tool",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 32
      }
    },
    "stars": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "pinned": {
      "type": "boolean",
      "description": "Pins this tool to the top of listings. Set by maintainers only.",
      "default": false
    }
  }
}
